{
  "name": "hike",
  "version": "0.1.0",
  "description": "Hike — system optimizer: cleaner, process manager, startup manager, performance boost",
  "main": "./out/main/index.js",
  "author": "Lukyan",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
